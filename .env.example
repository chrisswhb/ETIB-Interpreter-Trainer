GROQ_API_KEY=put_your_groq_key_here
COHERE_API_KEY=put_your_cohere_key_here
COHERE_ARABIC_ASR_MODEL=cohere-transcribe-arabic-07-2026

# Optional: point this at a hosted OpenAI-compatible Gemma endpoint.
# If omitted, the expert pipeline uses GROQ_API_KEY as a temporary LLM fallback.
GEMMA_OPENAI_BASE_URL=
GEMMA_API_KEY=
GEMMA_MODEL_ID=google/gemma-4-12B-it

# Optional alignment experiments. Leave off for fast local testing.
ENABLE_GEMMA_ALIGNMENT=0
ENABLE_GROQ_AS_GEMMA_ALIGNMENT=0
ENABLE_GROQ_WORD_TIMESTAMPS=0
ENABLE_GROQ_SENTENCE_SCORING=0
USE_AUGMENTED_ACOUSTIC_CLASSIFIER=0
